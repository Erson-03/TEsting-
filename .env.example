# PARA frontend demo mode.
# Keep this true while working only on the frontend.
VITE_USE_MOCK_API=true

# Reserved for future API connection. The frontend works without these values
# while mock mode is enabled.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT_MS=15000

# When VITE_USE_MOCK_API=false, PARA AI uses POST /assistant/chat
# on the same VITE_API_BASE_URL.
